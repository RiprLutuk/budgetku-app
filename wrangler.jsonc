{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budgetku",
  "main": "api/index.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "budgetku",
      "database_id": "f80a3dac-919c-44dc-9a51-df160f29f3db",
      "migrations_dir": "migrations"
    }
  ]
}
